<?xml version="1.0" encoding="utf-8"?>
<!-- Not loaded by anything: AndroidManifest declares android:icon but no
     android:roundIcon. Kept correct anyway so it stops being a landmine if
     roundIcon is ever added. Note this file is NOT generated by
     flutter_launcher_icons, unlike ic_launcher.xml next to it, so it will not
     be refreshed automatically when the mark changes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
