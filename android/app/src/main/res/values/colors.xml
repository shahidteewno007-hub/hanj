<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kept at the same value as splash_bg and the adaptive background drawable.
         Was #0A0806, a third near-black that appeared nowhere else. Note the name
         collision with @drawable/ic_launcher_background is deliberate and left
         alone: ic_launcher.xml uses the drawable, ic_launcher_round.xml uses this
         colour, and they now resolve to the same value.
         Stage H2 moved splash_bg to sumi #121110, and this followed when the
         launcher icons were regenerated at #121110 with the Clean Cut mark
         (tools/regenerate_brand.mjs), so the two launcher icons still match. -->
    <color name="ic_launcher_background">#121110</color>
    <color name="splash_bg">#121110</color>
    <!-- Tint FCM applies to the monochrome status-bar icon. -->
    <color name="notification_accent">#E8624A</color>
</resources>
