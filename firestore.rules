rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Signed-in only. This document holds `email` and `fcmToken`, so it was
      // never safe to serve unauthenticated.
      //
      // KNOWN RESIDUAL: this still lets any signed-in user read any other
      // user's document, including those two fields. It is not owner-only
      // because soulmatch_screen resolves a friend code by scanning every user
      // document for `displayName`, and Firestore rules cannot expose one field
      // while hiding another — read access is all-or-nothing per document.
      //
      // The fix is a public/private split (public profile doc for displayName,
      // avatar, founder badge; email and fcmToken owner-only). That is blocked,
      // not merely pending: its backfill and the fcmToken relocation both need
      // a functions deploy, which the phantom `aruku` codebase currently
      // prevents. See AUDIT.md 6d and 5-F.
      allow read: if request.auth != null;
      // Owner can write their own doc, but the founderNumber is immutable
      // once set — it can never be changed or removed after assignment.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && (
        !('founderNumber' in resource.data)
        || request.resource.data.founderNumber == resource.data.founderNumber
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
      match /animeList/{animeId} {
        // Signed-in only. A watch list is personal data — what someone is
        // watching, how far in, and how they rated it — and there is no
        // logged-out surface that needs it.
        //
        // Not owner-only: soulmatch_screen compares two users' lists by
        // reading the friend's animeList directly, so cross-user reads have to
        // keep working for signed-in callers.
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // Cards: Cloud Functions create them, but user can delete (for account wipe)
      match /cards/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // Cloud Functions only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /pinnedCards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /alerts/{animeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // firedAlerts: Cloud Functions write them, but user can delete (for account wipe)
      match /firedAlerts/{fireKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // Cloud Functions only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /activity/{activityId} {
        // Signed-in only, same reasoning as animeList: activity entries carry
        // anime titles, cover art and status changes, which is watch history
        // in another shape.
        //
        // Not owner-only: FirestoreService.getUserActivity(uid) takes an
        // arbitrary uid to build the social feed, so a signed-in user must
        // still be able to read another user's activity.
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // Loki's conversation history. Previously had no rule at all, so it fell
      // through to default-deny and TomoService.loadHistory() failed silently
      // — the function kept writing both sides of the conversation while the
      // client could never read any of it back.
      //
      // Owner-only read. No client write under any circumstances: chatWithTomo
      // writes both messages with the Admin SDK, which bypasses rules
      // entirely, so a client write here could only ever be forged history.
      match /companion_chat/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Cloud Functions only
      }
      // companion_meta (the daily usage counter) has no rule on purpose. Only
      // chatWithTomo touches it, via the Admin SDK, and the client must never
      // read or write it — a client that could write it could reset its own
      // daily cap. Default-deny is the correct rule, so there isn't one.

      // ── Follow graph ──────────────────────────────────────────
      // A follow is two mirrored edges. When A follows B the client writes
      // users/B/followers/A and users/A/following/B, so these two blocks are
      // owned by different people and cannot share one condition.
      //
      // Reads: signed-in only. Who follows whom is social graph data, and
      // nothing renders it logged out, so there is no reason to serve it
      // unauthenticated.
      //
      // Writes: scoped to the writer's own end of the edge. You may add or
      // remove yourself from anyone's followers, and add or remove anyone
      // from your own following. You cannot put a third party into someone
      // else's graph — which is exactly what the previous
      // `allow write: if request.auth != null` allowed anyone to do.
      //
      // KNOWN RESIDUAL: document *contents* are unconstrained, so a follower
      // can store arbitrary fields in a document under another user's
      // subtree. No client writes these collections yet, so the shape isn't
      // known well enough to validate; worth a field check once one does.
      //
      // NOT granted, deliberately: the profile owner removing an unwanted
      // follower. That needs userId to be able to delete
      // users/{userId}/followers/{followerId} too, and there is no
      // remove-follower feature to justify widening the rule yet. Add it
      // with the feature, not before.
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
      match /following/{followingId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Founder counter ───────────────────────────────────────
    // WHAT THIS ENFORCES: the counter itself is monotonic. Any signed-in user
    // may read it, and an update must move `count` up by exactly 1 and never
    // above 50. It cannot be decremented or reset (no delete rule either).
    //
    // WHAT THIS DOES NOT ENFORCE — and an earlier version of this comment
    // claimed it did: **the founder claim is not secured.** Nothing here ties
    // a badge to the counter. Two holes, both open:
    //
    //   1. The badge does not require the counter at all. `founderNumber` is
    //      frozen by the /users rule only once it exists, so the FIRST write
    //      is unconstrained: a client can write
    //      `{ isFounder: true, founderNumber: 1 }` straight to its own user
    //      document, never touch this counter, and keep the badge forever.
    //      `isFounder` and `founderJoinedAt` are not constrained at all.
    //
    //   2. Incrementing costs nothing. Any signed-in user can run the counter
    //      from 0 to 50 in fifty writes without becoming a founder, denying
    //      the programme to everyone else.
    //
    // This cannot be closed in rules alone: rules constrain the shape of a
    // write, not the honesty of the client making it, and the client is the
    // attacker here. The claim has to move into a callable function using the
    // Admin SDK. Proposal and migration plan: AUDIT.md §6e (R2).
    match /meta/founders {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 50;
    }

    match /reviews/{reviewId} {
      // Signed-in only. No client touches reviews today (reviews_screen was
      // never recovered), so nothing can break. But this block came from the
      // console, so the lost screen probably wrote here, and if it used the
      // same author fields as episodeDiscussions, any documents it left carry
      // email addresses too. Whether any exist is unknown. AUDIT.md §6g.
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Author can edit/delete their own review. Any signed-in user may update
      // ONLY the vote-count fields (so up/down-voting others' reviews works).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes', 'downvotes', 'helpfulCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      match /votes/{voteId} {
        allow read, write: if request.auth != null;
      }
    }
    // ── Episode discussions ───────────────────────────────────
    // EpisodeDiscussionScreen: one thread per anime (episodeNumber 0 is the
    // series thread); a reply is an ordinary comment carrying a parentId.
    //
    // Reads: signed-in only. This was `if true`, and every comment written
    // before the D13 fix also stored its author's email address. The only
    // reader sits behind AuthWrapper, so nothing logged-out loses anything.
    // Signing up is free, though: this narrows who can read those older
    // documents, it does not hide them. The backfill in AUDIT.md §6g does.
    //
    // Create: the author must be the caller (R5: a client could post under
    // someone else's uid), and the document must not carry `userEmail`. That
    // second condition rejects posts from any install older than the D13 fix
    // instead of letting it keep publishing the address; the user sees
    // "Failed to post" with their text restored. Counters start at zero, and
    // `createdAt` must be the server's own time: the thread sorts newest
    // first, so a future timestamp would pin a comment to the top for good.
    //
    // Votes (R5): see below. Every build in git history votes the same way.
    match /episodeDiscussions/{commentId} {

      function changedC() { return request.resource.data.diff(resource.data); }
      function up(dir)    { return dir == 1 ? 1 : 0; }
      function down(dir)  { return dir == -1 ? 1 : 0; }
      function myVote() {
        return /databases/$(database)/documents/episodeDiscussions/$(commentId)/votes/$(request.auth.uid);
      }

      // A vote. The client votes in one transaction (`_vote` in the screen):
      // it writes its own record at votes/{uid} ({dir: 1 | -1}, deleted to
      // un-vote) and moves upvotes/downvotes to match. The counters may move
      // only by exactly what the caller's own record moves by, in the same
      // write. New vote, un-vote and switching direction all fit; a counter
      // write with no matching record change does not. This replaces a rule
      // that let anyone set either counter to any value on any comment.
      function isVote() {
        let before = exists(myVote()) ? get(myVote()).data.dir : 0;
        let after = existsAfter(myVote()) ? getAfter(myVote()).data.dir : 0;
        return changedC().affectedKeys().hasOnly(['upvotes', 'downvotes'])
          && before != after
          && request.resource.data.upvotes
               == resource.data.upvotes + up(after) - up(before)
          && request.resource.data.downvotes
               == resource.data.downvotes + down(after) - down(before);
      }
      // The author editing their own text. Nothing in the app edits comments
      // today; this keeps the old rule's intent without letting the author
      // also set their own counters or hand the comment to someone else.
      function isAuthorEdit() {
        return resource.data.userId == request.auth.uid
          && changedC().affectedKeys().hasOnly(['commentText', 'containsSpoilers']);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && !('userEmail' in request.resource.data)
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (isVote() || isAuthorEdit());
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // One record per voter, readable and writable only by that voter, and
      // writable only together with the matching counter change on the
      // comment — the mirror of isVote(). Without it, a record written or
      // deleted on its own would let the next "un-vote" drain someone's
      // counter, or let the same person vote twice.
      match /votes/{voterId} {
        function comment() {
          return /databases/$(database)/documents/episodeDiscussions/$(commentId);
        }
        function countersFollow(after) {
          let before = resource == null ? 0 : resource.data.dir;
          let was = get(comment()).data;
          let now = getAfter(comment()).data;
          return now.upvotes == was.upvotes + up(after) - up(before)
            && now.downvotes == was.downvotes + down(after) - down(before);
        }
        allow read: if request.auth != null && request.auth.uid == voterId;
        allow create, update: if request.auth != null && request.auth.uid == voterId
          && request.resource.data.dir in [1, -1]
          && request.resource.data.keys().hasOnly(['dir', 'votedAt'])
          && countersFollow(request.resource.data.dir);
        allow delete: if request.auth != null && request.auth.uid == voterId
          && countersFollow(0);
      }
    }

    // ─────────────────── Arcs (community feature) ───────────────────
    match /arcs/{arcId} {

      function uid()     { return request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data); }

      // Join: you add ONLY yourself; memberCount +1; nothing else changes.
      function isJoin() {
        return !(uid() in resource.data.members)
          && (uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && changed().affectedKeys().hasOnly(['members', 'memberCount']);
      }
      // Leave: you remove ONLY yourself; memberCount -1; nothing else changes.
      function isLeave() {
        return (uid() in resource.data.members)
          && !(uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && changed().affectedKeys().hasOnly(['members', 'memberCount']);
      }
      // A member bumping postCount by 1 when they add a post.
      function isPostCountBump() {
        return (uid() in resource.data.members)
          && request.resource.data.postCount == resource.data.postCount + 1
          && changed().affectedKeys().hasOnly(['postCount']);
      }
      // The creator editing arc metadata (name, description, emoji, tags).
      function isCreatorEdit() {
        return resource.data.createdBy == uid()
          && !changed().affectedKeys().hasAny(['createdBy', 'members', 'memberCount']);
      }

      allow read: if request.auth != null;

      // Create: you are the creator, the only initial member, counters honest.
      allow create: if request.auth != null
        && request.resource.data.createdBy == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.memberCount == 1
        && request.resource.data.postCount == 0;

      allow update: if request.auth != null
        && (isJoin() || isLeave() || isPostCountBump() || isCreatorEdit());

      allow delete: if request.auth != null && resource.data.createdBy == uid();

      // ── Posts ──
      match /posts/{postId} {

        function arc()      { return get(/databases/$(database)/documents/arcs/$(arcId)).data; }
        function isMember() { return request.auth.uid in arc().members; }
        function changedP() { return request.resource.data.diff(resource.data); }

        // Like toggle: add/remove ONLY yourself; likeCount +/- 1.
        function isLikeToggle() {
          return changedP().affectedKeys().hasOnly(['likes', 'likeCount'])
            && (
              (!(request.auth.uid in resource.data.likes)
                && (request.auth.uid in request.resource.data.likes)
                && request.resource.data.likeCount == resource.data.likeCount + 1)
              ||
              ((request.auth.uid in resource.data.likes)
                && !(request.auth.uid in request.resource.data.likes)
                && request.resource.data.likeCount == resource.data.likeCount - 1)
            );
        }
        // A replier bumping replyCount by 1.
        function isReplyCountBump() {
          return request.resource.data.replyCount == resource.data.replyCount + 1
            && changedP().affectedKeys().hasOnly(['replyCount']);
        }
        // Author editing their own post text.
        function isAuthorEdit() {
          return resource.data.authorId == request.auth.uid
            && changedP().affectedKeys().hasOnly(['title', 'body']);
        }

        allow read: if request.auth != null;

        // Must be a member to post (matches the "Join to post" gate in the UI).
        allow create: if request.auth != null
          && isMember()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.likes == []
          && request.resource.data.likeCount == 0
          && request.resource.data.replyCount == 0;

        allow update: if request.auth != null
          && (isLikeToggle() || isReplyCountBump() || isAuthorEdit());

        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid
              || arc().createdBy == request.auth.uid);

        // ── Replies ──
        // Any signed-in user can reply (the reply box isn't membership-gated in
        // the UI). To make replies members-only instead, add
        //   && (request.auth.uid in arc().members)
        // to the create rule below.
        match /replies/{replyId} {

          function changedRep() { return request.resource.data.diff(resource.data); }
          // Like toggle on a reply: add/remove ONLY yourself; likeCount +/- 1.
          function isReplyLikeToggle() {
            return changedRep().affectedKeys().hasOnly(['likes', 'likeCount'])
              && (
                (!(request.auth.uid in resource.data.likes)
                  && (request.auth.uid in request.resource.data.likes)
                  && request.resource.data.likeCount == resource.data.likeCount + 1)
                ||
                ((request.auth.uid in resource.data.likes)
                  && !(request.auth.uid in request.resource.data.likes)
                  && request.resource.data.likeCount == resource.data.likeCount - 1)
              );
          }

          allow read: if request.auth != null;

          allow create: if request.auth != null
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.likes == []
            && request.resource.data.likeCount == 0;

          allow update: if request.auth != null
            && (
              (resource.data.authorId == request.auth.uid
                && changedRep().affectedKeys().hasOnly(['body']))
              || isReplyLikeToggle()
            );

          allow delete: if request.auth != null
            && (resource.data.authorId == request.auth.uid
                || arc().createdBy == request.auth.uid);
        }
      }
    }
  }
}