rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Signed-in only. This document holds `email` and `fcmToken`, so it was
      // never safe to serve unauthenticated.
      //
      // KNOWN RESIDUAL: this still lets any signed-in user read any other
      // user's document, including those two fields. It is not owner-only
      // because soulmatch_screen resolves a friend code by scanning every user
      // document for `displayName`, and Firestore rules cannot expose one field
      // while hiding another — read access is all-or-nothing per document.
      //
      // The fix is a public/private split (public profile doc for displayName,
      // avatar, founder badge; email and fcmToken owner-only). That is blocked,
      // not merely pending: its backfill and the fcmToken relocation both need
      // a functions deploy, which the phantom `aruku` codebase currently
      // prevents. See AUDIT.md 6d and 5-F.
      allow read: if request.auth != null;
      // Owner can write their own doc, but the founderNumber is immutable
      // once set — it can never be changed or removed after assignment.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && (
        !('founderNumber' in resource.data)
        || request.resource.data.founderNumber == resource.data.founderNumber
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
      match /animeList/{animeId} {
        // Signed-in only. A watch list is personal data — what someone is
        // watching, how far in, and how they rated it — and there is no
        // logged-out surface that needs it.
        //
        // Not owner-only: soulmatch_screen compares two users' lists by
        // reading the friend's animeList directly, so cross-user reads have to
        // keep working for signed-in callers.
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // Cards: Cloud Functions create them, but user can delete (for account wipe)
      match /cards/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // Cloud Functions only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /pinnedCards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /alerts/{animeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // firedAlerts: Cloud Functions write them, but user can delete (for account wipe)
      match /firedAlerts/{fireKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // Cloud Functions only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /activity/{activityId} {
        // Signed-in only, same reasoning as animeList: activity entries carry
        // anime titles, cover art and status changes, which is watch history
        // in another shape.
        //
        // Not owner-only: FirestoreService.getUserActivity(uid) takes an
        // arbitrary uid to build the social feed, so a signed-in user must
        // still be able to read another user's activity.
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // Loki's conversation history. Previously had no rule at all, so it fell
      // through to default-deny and TomoService.loadHistory() failed silently
      // — the function kept writing both sides of the conversation while the
      // client could never read any of it back.
      //
      // Owner-only read. No client write under any circumstances: chatWithTomo
      // writes both messages with the Admin SDK, which bypasses rules
      // entirely, so a client write here could only ever be forged history.
      match /companion_chat/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Cloud Functions only
      }
      // companion_meta (the daily usage counter) has no rule on purpose. Only
      // chatWithTomo touches it, via the Admin SDK, and the client must never
      // read or write it — a client that could write it could reset its own
      // daily cap. Default-deny is the correct rule, so there isn't one.

      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /following/{followingId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ── Founder counter ───────────────────────────────────────
    // Anyone signed in may read it (to show "X spots left"). It may only
    // ever be incremented by exactly 1 and never past 50, which is what
    // makes client-side founder claiming safe — a tampered client cannot
    // grant itself an arbitrary number or reset the count.
    match /meta/founders {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 50;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Author can edit/delete their own review. Any signed-in user may update
      // ONLY the vote-count fields (so up/down-voting others' reviews works).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes', 'downvotes', 'helpfulCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      match /votes/{voteId} {
        allow read, write: if request.auth != null;
      }
    }
    match /episodeDiscussions/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Same pattern: author edits content, anyone votes on counts.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes', 'downvotes', 'helpfulCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      match /votes/{voteId} {
        allow read, write: if request.auth != null;
      }
    }

    // ─────────────────── Arcs (community feature) ───────────────────
    match /arcs/{arcId} {

      function uid()     { return request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data); }

      // Join: you add ONLY yourself; memberCount +1; nothing else changes.
      function isJoin() {
        return !(uid() in resource.data.members)
          && (uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && changed().affectedKeys().hasOnly(['members', 'memberCount']);
      }
      // Leave: you remove ONLY yourself; memberCount -1; nothing else changes.
      function isLeave() {
        return (uid() in resource.data.members)
          && !(uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && changed().affectedKeys().hasOnly(['members', 'memberCount']);
      }
      // A member bumping postCount by 1 when they add a post.
      function isPostCountBump() {
        return (uid() in resource.data.members)
          && request.resource.data.postCount == resource.data.postCount + 1
          && changed().affectedKeys().hasOnly(['postCount']);
      }
      // The creator editing arc metadata (name, description, emoji, tags).
      function isCreatorEdit() {
        return resource.data.createdBy == uid()
          && !changed().affectedKeys().hasAny(['createdBy', 'members', 'memberCount']);
      }

      allow read: if request.auth != null;

      // Create: you are the creator, the only initial member, counters honest.
      allow create: if request.auth != null
        && request.resource.data.createdBy == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.memberCount == 1
        && request.resource.data.postCount == 0;

      allow update: if request.auth != null
        && (isJoin() || isLeave() || isPostCountBump() || isCreatorEdit());

      allow delete: if request.auth != null && resource.data.createdBy == uid();

      // ── Posts ──
      match /posts/{postId} {

        function arc()      { return get(/databases/$(database)/documents/arcs/$(arcId)).data; }
        function isMember() { return request.auth.uid in arc().members; }
        function changedP() { return request.resource.data.diff(resource.data); }

        // Like toggle: add/remove ONLY yourself; likeCount +/- 1.
        function isLikeToggle() {
          return changedP().affectedKeys().hasOnly(['likes', 'likeCount'])
            && (
              (!(request.auth.uid in resource.data.likes)
                && (request.auth.uid in request.resource.data.likes)
                && request.resource.data.likeCount == resource.data.likeCount + 1)
              ||
              ((request.auth.uid in resource.data.likes)
                && !(request.auth.uid in request.resource.data.likes)
                && request.resource.data.likeCount == resource.data.likeCount - 1)
            );
        }
        // A replier bumping replyCount by 1.
        function isReplyCountBump() {
          return request.resource.data.replyCount == resource.data.replyCount + 1
            && changedP().affectedKeys().hasOnly(['replyCount']);
        }
        // Author editing their own post text.
        function isAuthorEdit() {
          return resource.data.authorId == request.auth.uid
            && changedP().affectedKeys().hasOnly(['title', 'body']);
        }

        allow read: if request.auth != null;

        // Must be a member to post (matches the "Join to post" gate in the UI).
        allow create: if request.auth != null
          && isMember()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.likes == []
          && request.resource.data.likeCount == 0
          && request.resource.data.replyCount == 0;

        allow update: if request.auth != null
          && (isLikeToggle() || isReplyCountBump() || isAuthorEdit());

        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid
              || arc().createdBy == request.auth.uid);

        // ── Replies ──
        // Any signed-in user can reply (the reply box isn't membership-gated in
        // the UI). To make replies members-only instead, add
        //   && (request.auth.uid in arc().members)
        // to the create rule below.
        match /replies/{replyId} {

          function changedRep() { return request.resource.data.diff(resource.data); }
          // Like toggle on a reply: add/remove ONLY yourself; likeCount +/- 1.
          function isReplyLikeToggle() {
            return changedRep().affectedKeys().hasOnly(['likes', 'likeCount'])
              && (
                (!(request.auth.uid in resource.data.likes)
                  && (request.auth.uid in request.resource.data.likes)
                  && request.resource.data.likeCount == resource.data.likeCount + 1)
                ||
                ((request.auth.uid in resource.data.likes)
                  && !(request.auth.uid in request.resource.data.likes)
                  && request.resource.data.likeCount == resource.data.likeCount - 1)
              );
          }

          allow read: if request.auth != null;

          allow create: if request.auth != null
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.likes == []
            && request.resource.data.likeCount == 0;

          allow update: if request.auth != null
            && (
              (resource.data.authorId == request.auth.uid
                && changedRep().affectedKeys().hasOnly(['body']))
              || isReplyLikeToggle()
            );

          allow delete: if request.auth != null
            && (resource.data.authorId == request.auth.uid
                || arc().createdBy == request.auth.uid);
        }
      }
    }
  }
}