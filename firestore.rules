rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Display names (code batch 2, LR-014) ──
    // A name heads every post and reply in Arcs, so it has limits: at most
    // 24 characters, and none of a few words that would make it speak for
    // Hanj, as a word of its own ("Hanj Team" is refused, "Hanjiro" isn't).
    // lib/core/display_name.dart runs the same test in the app; keep the
    // two lists in step. Checked on the user document when the name
    // changes, and on every name a new arc, post or reply carries.
    function hanjNameOk(n) {
      return n is string && n.size() <= 24
        && !n.lower().matches(
          '(.*[^a-z0-9])?(hanj|admin|administrator|moderator|mod|support|official|staff)([^a-z0-9].*)?');
    }

    match /users/{userId} {
      // Owner-only (code batch 2, Q178, LR-008). This document holds
      // `email` and `fcmToken`, and it was readable by every signed-in user
      // because soulmatch_screen found a friend's code by scanning every
      // user document. Soulmatch is hidden (SocialScreen.soulmatch, code
      // batch 1), and nothing else in the app reads another user's
      // document: Arcs prints the name saved on each post and reply.
      //
      // Soulmatch returns with a public half: a small profile document per
      // user (name, avatar, friend's code) that signed-in users may read,
      // while this one stays the owner's (AUDIT.md 6d, shape C).
      allow read: if request.auth != null && request.auth.uid == userId;
      // Owner can write their own doc, but the founderNumber is immutable
      // once set — it can never be changed or removed after assignment.
      //
      // The name: a new or changed displayName must pass hanjNameOk. A name
      // saved before the limits keeps working until its owner changes it.
      function nameKept() {
        return !('displayName' in request.resource.data)
          || (resource != null && 'displayName' in resource.data
              && request.resource.data.displayName == resource.data.displayName)
          || hanjNameOk(request.resource.data.displayName);
      }
      allow create: if request.auth != null && request.auth.uid == userId
        && nameKept();
      allow update: if request.auth != null && request.auth.uid == userId && (
        !('founderNumber' in resource.data)
        || request.resource.data.founderNumber == resource.data.founderNumber
      ) && nameKept();
      allow delete: if request.auth != null && request.auth.uid == userId;
      match /animeList/{animeId} {
        // Owner-only (code batch 2, Q178, LR-008). A watch list is personal
        // data: what someone is watching, how far in, and how they rated it.
        // The one reader of another user's list was soulmatch_screen, which
        // is hidden; it comes back reading lists its owner chose to share.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // Cards: Cloud Functions create them, but user can delete (for account wipe)
      match /cards/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // Cloud Functions only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /pinnedCards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /alerts/{animeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // firedAlerts: Cloud Functions write them, but user can delete (for account wipe)
      match /firedAlerts/{fireKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false; // Cloud Functions only
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /activity/{activityId} {
        // Owner-only (code batch 2, Q178, LR-008), as animeList: activity
        // entries are watch history in another shape. Their one cross-user
        // reader was the Friends tab (getFriendsActivity), hidden by
        // _friendsTab in code batch 1; nobody can follow anyone yet.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      // Loki's conversation history. Previously had no rule at all, so it fell
      // through to default-deny and TomoService.loadHistory() failed silently
      // — the function kept writing both sides of the conversation while the
      // client could never read any of it back.
      //
      // Owner-only read. No client write under any circumstances: chatWithTomo
      // writes both messages with the Admin SDK, which bypasses rules
      // entirely, so a client write here could only ever be forged history.
      match /companion_chat/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Cloud Functions only
      }
      // companion_meta (the daily usage counter) has no rule on purpose. Only
      // chatWithTomo touches it, via the Admin SDK, and the client must never
      // read or write it — a client that could write it could reset its own
      // daily cap. Default-deny is the correct rule, so there isn't one.

      // ── Follow graph ──────────────────────────────────────────
      // A follow is two mirrored edges. When A follows B the client writes
      // users/B/followers/A and users/A/following/B, so these two blocks are
      // owned by different people and cannot share one condition.
      //
      // Reads: signed-in only. Who follows whom is social graph data, and
      // nothing renders it logged out, so there is no reason to serve it
      // unauthenticated.
      //
      // Writes: scoped to the writer's own end of the edge. You may add or
      // remove yourself from anyone's followers, and add or remove anyone
      // from your own following. You cannot put a third party into someone
      // else's graph — which is exactly what the previous
      // `allow write: if request.auth != null` allowed anyone to do.
      //
      // KNOWN RESIDUAL: document *contents* are unconstrained, so a follower
      // can store arbitrary fields in a document under another user's
      // subtree. No client writes these collections yet, so the shape isn't
      // known well enough to validate; worth a field check once one does.
      //
      // NOT granted, deliberately: the profile owner removing an unwanted
      // follower. That needs userId to be able to delete
      // users/{userId}/followers/{followerId} too, and there is no
      // remove-follower feature to justify widening the rule yet. Add it
      // with the feature, not before.
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
      match /following/{followingId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Founder counter ───────────────────────────────────────
    // WHAT THIS ENFORCES: the counter itself is monotonic. Any signed-in user
    // may read it, and an update must move `count` up by exactly 1 and never
    // above 50. It cannot be decremented or reset (no delete rule either).
    //
    // WHAT THIS DOES NOT ENFORCE — and an earlier version of this comment
    // claimed it did: **the founder claim is not secured.** Nothing here ties
    // a badge to the counter. Two holes, both open:
    //
    //   1. The badge does not require the counter at all. `founderNumber` is
    //      frozen by the /users rule only once it exists, so the FIRST write
    //      is unconstrained: a client can write
    //      `{ isFounder: true, founderNumber: 1 }` straight to its own user
    //      document, never touch this counter, and keep the badge forever.
    //      `isFounder` and `founderJoinedAt` are not constrained at all.
    //
    //   2. Incrementing costs nothing. Any signed-in user can run the counter
    //      from 0 to 50 in fifty writes without becoming a founder, denying
    //      the programme to everyone else.
    //
    // This cannot be closed in rules alone: rules constrain the shape of a
    // write, not the honesty of the client making it, and the client is the
    // attacker here. The claim has to move into a callable function using the
    // Admin SDK. Proposal and migration plan: AUDIT.md §6e (R2).
    match /meta/founders {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 50;
    }

    match /reviews/{reviewId} {
      // CLOSED (code batch 2, LR-020): no reads, no writes. Nothing in the
      // app reads or writes reviews (reviews_screen was never recovered),
      // yet the block let any account store anything here, and account
      // deletion never cleared it. The old rules stay below behind
      // reviewsOpen(), so the shape isn't lost; true gives them back.
      //
      // Before: signed-in only. This block came from the console, so the
      // lost screen probably wrote here, and if it used the same author
      // fields as episodeDiscussions, any documents it left carry email
      // addresses too. Whether any exist is unknown. AUDIT.md §6g.
      function reviewsOpen() { return false; }
      allow read: if reviewsOpen() && request.auth != null;
      allow create: if reviewsOpen() && request.auth != null;
      // Author can edit/delete their own review. Any signed-in user may update
      // ONLY the vote-count fields (so up/down-voting others' reviews works).
      allow update: if reviewsOpen() && request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes', 'downvotes', 'helpfulCount'])
      );
      allow delete: if reviewsOpen() && request.auth != null
        && request.auth.uid == resource.data.userId;
      match /votes/{voteId} {
        allow read, write: if reviewsOpen() && request.auth != null;
      }
    }
    // ── Episode discussions ───────────────────────────────────
    // EpisodeDiscussionScreen: one thread per anime (episodeNumber 0 is the
    // series thread); a reply is an ordinary comment carrying a parentId.
    //
    // Reads: signed-in only. This was `if true`, and every comment written
    // before the D13 fix also stored its author's email address. The only
    // reader sits behind AuthWrapper, so nothing logged-out loses anything.
    // Signing up is free, though: this narrows who can read those older
    // documents, it does not hide them. The backfill in AUDIT.md §6g does.
    //
    // Create: the author must be the caller (R5: a client could post under
    // someone else's uid), and the document must not carry `userEmail`. That
    // second condition rejects posts from any install older than the D13 fix
    // instead of letting it keep publishing the address; the user sees
    // "Failed to post" with their text restored. Counters start at zero, and
    // `createdAt` must be the server's own time: the thread sorts newest
    // first, so a future timestamp would pin a comment to the top for good.
    //
    // Votes (R5): see below. Every build in git history votes the same way.
    //
    // CLOSED TO NEW WORDS (code batch 2, LR-005): Discussion is hidden
    // (_discussionDoor, code batch 1) and has no report, block or length
    // cap, so the rules take no new comment and no edit. A cap alone would
    // still let a script post into a public thread nobody watches. Reads,
    // votes and an author deleting their own comment stay, so account
    // deletion still clears a user's comments. discussionsOpen() true gives
    // back the rules as they were; Discussion should return only with
    // report, block and a cap.
    match /episodeDiscussions/{commentId} {

      function discussionsOpen() { return false; }

      function changedC() { return request.resource.data.diff(resource.data); }
      function up(dir)    { return dir == 1 ? 1 : 0; }
      function down(dir)  { return dir == -1 ? 1 : 0; }
      function myVote() {
        return /databases/$(database)/documents/episodeDiscussions/$(commentId)/votes/$(request.auth.uid);
      }

      // A vote. The client votes in one transaction (`_vote` in the screen):
      // it writes its own record at votes/{uid} ({dir: 1 | -1}, deleted to
      // un-vote) and moves upvotes/downvotes to match. The counters may move
      // only by exactly what the caller's own record moves by, in the same
      // write. New vote, un-vote and switching direction all fit; a counter
      // write with no matching record change does not. This replaces a rule
      // that let anyone set either counter to any value on any comment.
      function isVote() {
        let before = exists(myVote()) ? get(myVote()).data.dir : 0;
        let after = existsAfter(myVote()) ? getAfter(myVote()).data.dir : 0;
        return changedC().affectedKeys().hasOnly(['upvotes', 'downvotes'])
          && before != after
          && request.resource.data.upvotes
               == resource.data.upvotes + up(after) - up(before)
          && request.resource.data.downvotes
               == resource.data.downvotes + down(after) - down(before);
      }
      // The author editing their own text. Nothing in the app edits comments
      // today; this keeps the old rule's intent without letting the author
      // also set their own counters or hand the comment to someone else.
      function isAuthorEdit() {
        return resource.data.userId == request.auth.uid
          && changedC().affectedKeys().hasOnly(['commentText', 'containsSpoilers']);
      }

      allow read: if request.auth != null;
      allow create: if discussionsOpen() && request.auth != null
        && request.resource.data.userId == request.auth.uid
        && !('userEmail' in request.resource.data)
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && (isVote() || (discussionsOpen() && isAuthorEdit()));
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // One record per voter, readable and writable only by that voter, and
      // writable only together with the matching counter change on the
      // comment — the mirror of isVote(). Without it, a record written or
      // deleted on its own would let the next "un-vote" drain someone's
      // counter, or let the same person vote twice.
      match /votes/{voterId} {
        function comment() {
          return /databases/$(database)/documents/episodeDiscussions/$(commentId);
        }
        function countersFollow(after) {
          let before = resource == null ? 0 : resource.data.dir;
          let was = get(comment()).data;
          let now = getAfter(comment()).data;
          return now.upvotes == was.upvotes + up(after) - up(before)
            && now.downvotes == was.downvotes + down(after) - down(before);
        }
        allow read: if request.auth != null && request.auth.uid == voterId;
        allow create, update: if request.auth != null && request.auth.uid == voterId
          && request.resource.data.dir in [1, -1]
          && request.resource.data.keys().hasOnly(['dir', 'votedAt'])
          && countersFollow(request.resource.data.dir);
        allow delete: if request.auth != null && request.auth.uid == voterId
          && countersFollow(0);
      }
    }

    // ─────────────────── Arcs (watch-alongs) ───────────────────
    // Arcs redesign (2026-11-14; arcs-design.md in the notes folder). An arc
    // is people watching one show together: `anime`, `from`..`to` episodes,
    // `pace` a week from `startsOn`. Its posts carry `ep`, the episode they
    // talk about.
    //
    // Counters (AUDIT R7): every counter moves by exactly 1 in the same batch
    // as the document it counts, and names it (`countedPost`,
    // `countedReply`), so the rule can check that document really appears
    // (+1) or disappears (-1) in that batch. Each side checks the other: a
    // post can't be created or deleted without its arc's count moving, and
    // the count can't move without the post.
    //
    // Text has limits and `createdAt` must be the server's own time (a
    // future timestamp would pin a post to the top). Writing (posts and
    // replies) is for members. An arc can be deleted only while it has no
    // posts, so its posts can never be stranded (AUDIT R8).
    match /arcs/{arcId} {

      function uid()     { return request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data); }
      function postAt(id) {
        return /databases/$(database)/documents/arcs/$(arcId)/posts/$(id);
      }
      function arcText(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.description is string && d.description.size() <= 300;
      }
      function arcShape(d) {
        return d.anime is map
          && d.anime.keys().hasOnly(['id', 'title', 'cover', 'episodes'])
          && d.anime.id is string && d.anime.id.size() <= 40
          && d.anime.title is string && d.anime.title.size() <= 300
          && (d.anime.get('cover', null) == null
              || (d.anime.cover is string && d.anime.cover.size() <= 500))
          && (d.anime.get('episodes', null) == null || d.anime.episodes is int)
          && d.from is int && d.to is int && d.pace is int
          && d.from >= 1 && d.to >= d.from && d.to <= 5000
          && d.pace >= 1 && d.pace <= 12
          && d.startsOn is timestamp
          && d.startsOn > request.time - duration.value(2, 'd')
          && d.startsOn < request.time + duration.value(31, 'd')
          && hanjNameOk(d.creatorName);
      }

      // Join: you add ONLY yourself; memberCount +1; nothing else changes.
      function isJoin() {
        return !(uid() in resource.data.members)
          && (uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && changed().affectedKeys().hasOnly(['members', 'memberCount']);
      }
      // Leave: you remove ONLY yourself; memberCount -1; nothing else changes.
      function isLeave() {
        return (uid() in resource.data.members)
          && !(uid() in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && changed().affectedKeys().hasOnly(['members', 'memberCount']);
      }
      // postCount moves by 1 with the post it names, in the same batch.
      function isPostCount() {
        let id = request.resource.data.countedPost;
        return changed().affectedKeys().hasOnly(['postCount', 'countedPost'])
          && id is string
          && (
            (request.resource.data.postCount == resource.data.postCount + 1
              && !exists(postAt(id)) && existsAfter(postAt(id)))
            ||
            (request.resource.data.postCount == resource.data.postCount - 1
              && exists(postAt(id)) && !existsAfter(postAt(id)))
          );
      }
      // The maker renaming the arc or rewriting what it's about.
      function isCreatorEdit() {
        return resource.data.createdBy == uid()
          && changed().affectedKeys().hasOnly(['name', 'description'])
          && arcText(request.resource.data);
      }
      // The maker deleting their account while other people's posts keep
      // the arc alive: it stays for them, without the maker's name or words.
      // Only these two fields, and only to exactly these values.
      function isMakerGone() {
        return resource.data.createdBy == uid()
          && changed().affectedKeys().hasOnly(['creatorName', 'description'])
          && request.resource.data.creatorName == 'Deleted account'
          && request.resource.data.description == '';
      }

      allow read: if request.auth != null;

      // Create: you are the maker, the only member, counters at their start,
      // and the arc has a show and a schedule.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['v', 'name', 'description',
             'anime', 'from', 'to', 'pace', 'startsOn', 'createdBy',
             'creatorName', 'members', 'memberCount', 'postCount', 'createdAt'])
        && request.resource.data.v == 2
        && request.resource.data.createdBy == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.memberCount == 1
        && request.resource.data.postCount == 0
        && request.resource.data.createdAt == request.time
        && arcText(request.resource.data)
        && arcShape(request.resource.data);

      allow update: if request.auth != null
        && (isJoin() || isLeave() || isPostCount() || isCreatorEdit()
            || isMakerGone());

      // Only an arc with no posts (nothing left behind under it).
      allow delete: if request.auth != null
        && resource.data.createdBy == uid()
        && resource.data.postCount == 0;

      // ── Posts ──
      match /posts/{postId} {

        function arcPath()  { return /databases/$(database)/documents/arcs/$(arcId); }
        function arc()      { return get(arcPath()).data; }
        function arcAfter() { return getAfter(arcPath()).data; }
        function isMember() { return request.auth.uid in arc().members; }
        function changedP() { return request.resource.data.diff(resource.data); }
        function replyAt(id) {
          return /databases/$(database)/documents/arcs/$(arcId)/posts/$(postId)/replies/$(id);
        }
        function postText(d) {
          return d.title is string && d.title.size() <= 120
            && d.body is string && d.body.size() > 0 && d.body.size() <= 2000;
        }
        // The arc's count moves with this post, in the same batch.
        function countedWith(step) {
          return arcAfter().postCount == arc().postCount + step
            && arcAfter().get('countedPost', '') == postId;
        }

        // Like toggle: add/remove ONLY yourself; likeCount +/- 1.
        function isLikeToggle() {
          return changedP().affectedKeys().hasOnly(['likes', 'likeCount'])
            && (
              (!(request.auth.uid in resource.data.likes)
                && (request.auth.uid in request.resource.data.likes)
                && request.resource.data.likeCount == resource.data.likeCount + 1)
              ||
              ((request.auth.uid in resource.data.likes)
                && !(request.auth.uid in request.resource.data.likes)
                && request.resource.data.likeCount == resource.data.likeCount - 1)
            );
        }
        // replyCount moves by 1 with the reply it names, in the same batch.
        function isReplyCount() {
          let id = request.resource.data.countedReply;
          return changedP().affectedKeys().hasOnly(['replyCount', 'countedReply'])
            && id is string
            && (
              (request.resource.data.replyCount == resource.data.replyCount + 1
                && !exists(replyAt(id)) && existsAfter(replyAt(id)))
              ||
              (request.resource.data.replyCount == resource.data.replyCount - 1
                && exists(replyAt(id)) && !existsAfter(replyAt(id)))
            );
        }
        // Author editing their own post text.
        function isAuthorEdit() {
          return resource.data.authorId == request.auth.uid
            && changedP().affectedKeys().hasOnly(['title', 'body'])
            && postText(request.resource.data);
        }

        allow read: if request.auth != null;

        // Members only, as yourself, counters at zero, server time, the
        // episode inside the arc's range, and counted on the arc.
        allow create: if request.auth != null
          && isMember()
          && request.resource.data.keys().hasOnly(['title', 'body', 'ep',
               'authorId', 'authorName', 'likes', 'likeCount', 'replyCount',
               'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && hanjNameOk(request.resource.data.authorName)
          && request.resource.data.likes == []
          && request.resource.data.likeCount == 0
          && request.resource.data.replyCount == 0
          && request.resource.data.createdAt == request.time
          && postText(request.resource.data)
          && (!('ep' in request.resource.data)
              || (request.resource.data.ep is int
                  && request.resource.data.ep >= arc().get('from', 1)
                  && request.resource.data.ep <= arc().get('to', 5000)))
          && countedWith(1);

        allow update: if request.auth != null
          && (isLikeToggle() || isReplyCount() || isAuthorEdit());

        // Under an arc that no longer exists (an old arc deleted with a
        // drifted count) there is no count to move, and only the author can
        // clear the post: account deletion's sweep. exists() reads the
        // state before the batch, so a batch can't delete the arc to use it.
        allow delete: if request.auth != null
          && (
            (resource.data.authorId == request.auth.uid && !exists(arcPath()))
            ||
            ((resource.data.authorId == request.auth.uid
                || arc().createdBy == request.auth.uid)
              && countedWith(-1))
          );

        // ── Replies ──
        // Members only, like posts (arcs-design.md A-6).
        match /replies/{replyId} {

          function postPath() {
            return /databases/$(database)/documents/arcs/$(arcId)/posts/$(postId);
          }
          // The post's count moves with this reply, in the same batch.
          function countedRep(step) {
            return getAfter(postPath()).data.replyCount
                == get(postPath()).data.replyCount + step
              && getAfter(postPath()).data.get('countedReply', '') == replyId;
          }
          function changedRep() { return request.resource.data.diff(resource.data); }
          // Like toggle on a reply: add/remove ONLY yourself; likeCount +/- 1.
          function isReplyLikeToggle() {
            return changedRep().affectedKeys().hasOnly(['likes', 'likeCount'])
              && (
                (!(request.auth.uid in resource.data.likes)
                  && (request.auth.uid in request.resource.data.likes)
                  && request.resource.data.likeCount == resource.data.likeCount + 1)
                ||
                ((request.auth.uid in resource.data.likes)
                  && !(request.auth.uid in request.resource.data.likes)
                  && request.resource.data.likeCount == resource.data.likeCount - 1)
              );
          }

          allow read: if request.auth != null;

          allow create: if request.auth != null
            && request.auth.uid in arc().members
            && request.resource.data.keys().hasOnly(['body', 'authorId',
                 'authorName', 'likes', 'likeCount', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && hanjNameOk(request.resource.data.authorName)
            && request.resource.data.likes == []
            && request.resource.data.likeCount == 0
            && request.resource.data.createdAt == request.time
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000
            && countedRep(1);

          allow update: if request.auth != null
            && (
              (resource.data.authorId == request.auth.uid
                && changedRep().affectedKeys().hasOnly(['body'])
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 1000)
              || isReplyLikeToggle()
            );

          // Under a post that no longer exists (its author deleted it) there
          // is no count to move, and only the reply's author can clear it:
          // account deletion's sweep. exists() reads the state before the
          // batch, so a batch can't delete the post to use it.
          allow delete: if request.auth != null
            && (
              (resource.data.authorId == request.auth.uid && !exists(postPath()))
              ||
              ((resource.data.authorId == request.auth.uid
                  || arc().createdBy == request.auth.uid)
                && countedRep(-1))
            );
        }
      }
    }

    // ── Arcs: finding your own posts, replies and likes ──
    // Account deletion finds what a user left in arcs with collection-group
    // queries (firestore.indexes.json holds the indexes they need). Listing
    // only, and only your own: a query must ask for your posts or replies
    // (authorId == you) or the posts you like (likes array-contains you).
    // Single documents and per-arc lists are governed by the arcs block.
    // `posts` and `replies` are arcs' names: no other collection may use them.
    match /{path=**}/posts/{postId} {
      allow list: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.auth.uid in resource.data.likes);
    }
    match /{path=**}/replies/{replyId} {
      allow list: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // ── Reports (arcs redesign) ──
    // Create-only: anyone signed in can report a post or reply in an arc, as
    // themselves. Nobody reads reports in the app; they're read in the
    // Firebase console.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporter', 'path', 'reason', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 400
        && request.resource.data.path.matches('arcs/[^/]+/posts/[^/]+(/replies/[^/]+)?')
        && request.resource.data.reason in ['spoiler', 'spam', 'abuse']
        && request.resource.data.createdAt == request.time;
    }
  }
}