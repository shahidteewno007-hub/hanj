# ---------------------------------------------------------------
# Flutter / Dart / Pub
# ---------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/doc/api/
app.*.symbols
app.*.map.json
migrate_working_dir/

